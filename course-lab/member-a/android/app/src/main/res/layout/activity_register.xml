<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background">
    <LinearLayout style="@style/Screen">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="12dp" android:src="@drawable/ic_wardrobe" android:importantForAccessibility="no"/>
        <TextView style="@style/Title" android:layout_marginTop="24dp" android:text="@string/activity_register_text_39"/>
        <TextView style="@style/Body" android:layout_marginTop="12dp" android:text="@string/activity_register_text_40"/>
        <TextView style="@style/Label" android:text="@string/activity_register_text_41" android:labelFor="@id/displayNameInput"/>
        <EditText android:id="@+id/displayNameInput" style="@style/Input" android:hint="@string/activity_register_hint_42" android:inputType="textPersonName|textCapWords" android:autofillHints="name" android:imeOptions="actionNext" android:maxLength="40"/>
        <TextView style="@style/Label" android:text="@string/activity_register_text_43" android:labelFor="@id/accountInput"/>
        <EditText android:id="@+id/accountInput" style="@style/Input" android:hint="@string/activity_register_hint_44" android:inputType="textVisiblePassword" android:autofillHints="newUsername" android:imeOptions="actionNext" android:maxLength="32"/>
        <TextView style="@style/Label" android:text="@string/activity_register_text_45" android:labelFor="@id/passwordInput"/>
        <EditText android:id="@+id/passwordInput" style="@style/Input" android:hint="@string/activity_register_hint_46" android:inputType="textPassword" android:autofillHints="newPassword" android:imeOptions="actionNext"/>
        <TextView style="@style/Label" android:text="@string/activity_register_text_47" android:labelFor="@id/confirmPasswordInput"/>
        <EditText android:id="@+id/confirmPasswordInput" style="@style/Input" android:hint="@string/activity_register_hint_48" android:inputType="textPassword" android:autofillHints="newPassword" android:imeOptions="actionDone"/>
        <TextView android:id="@+id/errorText" style="@style/Error"/>
        <ProgressBar android:id="@+id/progress" style="@style/Progress"/>
        <Button android:id="@+id/primaryButton" style="@style/PrimaryButton" android:text="@string/activity_register_text_49"/>
        <TextView android:id="@+id/secondaryButton" style="@style/TextButton" android:text="@string/activity_register_text_50"/>
    </LinearLayout>
</ScrollView>
