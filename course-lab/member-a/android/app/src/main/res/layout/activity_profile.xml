<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background">
    <LinearLayout style="@style/Screen">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="12dp" android:src="@drawable/ic_wardrobe" android:importantForAccessibility="no"/>
        <TextView style="@style/Title" android:layout_marginTop="28dp" android:text="@string/activity_profile_text_31"/>
        <TextView style="@style/Body" android:layout_marginTop="12dp" android:text="@string/activity_profile_text_32"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:orientation="vertical" android:background="@drawable/bg_sage" android:padding="20dp">
            <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/activity_profile_text_33" android:textSize="11sp" android:letterSpacing="0.1"/>
            <TextView android:id="@+id/accountText" style="@style/Body" android:textColor="@color/ink" android:textSize="18sp" android:textIsSelectable="true"/>
            <TextView style="@style/CardBody" android:layout_marginTop="8dp" android:text="@string/activity_profile_text_34"/>
        </LinearLayout>
        <TextView style="@style/Label" android:layout_marginTop="28dp" android:text="@string/activity_profile_text_35" android:labelFor="@id/displayNameInput"/>
        <EditText android:id="@+id/displayNameInput" style="@style/Input" android:hint="@string/activity_profile_hint_36" android:inputType="textPersonName|textCapWords" android:autofillHints="name" android:imeOptions="actionDone" android:maxLength="40"/>
        <TextView android:id="@+id/errorText" style="@style/Error"/>
        <ProgressBar android:id="@+id/progress" style="@style/Progress"/>
        <Button android:id="@+id/primaryButton" style="@style/PrimaryButton" android:text="@string/activity_profile_text_37"/>
        <TextView android:id="@+id/secondaryButton" style="@style/TextButton" android:text="@string/activity_profile_text_38"/>
    </LinearLayout>
</ScrollView>
